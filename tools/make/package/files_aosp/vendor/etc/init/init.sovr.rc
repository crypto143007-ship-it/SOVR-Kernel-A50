# SOVR Kernel Optimization Script for AOSP / GSI
# Automatically loaded by vendor init on every boot

on early-init
    write /proc/sys/kernel/sched_nr_migrate 20

on boot
    # SurfaceFlinger fluidity & backpressure fixes for Mali-G72 on GSIs
    setprop persist.sys.phh.sf_disable_backpressure 1
    setprop persist.sys.phh.enable_sf_gl_backpressure 0
    setprop persist.sys.phh.enable_sf_hwc_backpressure 0
    setprop persist.sys.phh.sf_latch_unsignaled 1
    setprop persist.sys.phh.sf_auto_latch_unsignaled 0

on property:sys.boot_completed=1
    # SOVR TCP Network Tuning (BBR buffer & latency optimization)
    write /proc/sys/net/core/rmem_max 16777216
    write /proc/sys/net/core/wmem_max 8388608
    write /proc/sys/net/ipv4/tcp_rmem "4096 87380 16777216"
    write /proc/sys/net/ipv4/tcp_wmem "4096 65536 8388608"
    write /proc/sys/net/ipv4/tcp_notsent_lowat 16384
    write /proc/sys/net/ipv4/tcp_fastopen 3
    write /proc/sys/net/ipv4/tcp_tw_reuse 1

    # CPU governor responsiveness (SOVR Energy Adaptive)
    write /sys/devices/system/cpu/cpufreq/policy0/energy_adaptive/iowait_boost_enable 1
    write /sys/devices/system/cpu/cpufreq/policy4/energy_adaptive/iowait_boost_enable 1
    write /sys/devices/system/cpu/cpufreq/policy0/energy_adaptive/up_rate_limit_us 100
    write /sys/devices/system/cpu/cpufreq/policy0/energy_adaptive/down_rate_limit_us 5000
    write /sys/devices/system/cpu/cpufreq/policy4/energy_adaptive/up_rate_limit_us 50
    write /sys/devices/system/cpu/cpufreq/policy4/energy_adaptive/down_rate_limit_us 5000

    # VM & Cache tuning
    write /proc/sys/vm/swappiness 160
    write /proc/sys/vm/vfs_cache_pressure 60
    write /proc/sys/vm/dirty_background_ratio 5
    write /proc/sys/vm/dirty_ratio 15

    # Cpuset boosting for UI
    write /dev/cpuset/top-app/cpus 0-7
    write /dev/cpuset/foreground/cpus 0-6
